

worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 1024; }

http {
  access_log off;
  # Fotos y exámenes (el backend acepta hasta 5 MB; nginx por defecto solo 1 MB)
  client_max_body_size 10m;

  server {
    listen __PUERTO__;
    listen [::]:__PUERTO__;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

    # API: directo al backend
    location /api/ { proxy_pass http://127.0.0.1:4000; }

    # Portal de la clínica (con y sin "/" final; no atrapa rutas como /clinicas)
    location = /clinica { proxy_pass http://127.0.0.1:3001; }
    location /clinica/  { proxy_pass http://127.0.0.1:3001; }

    # Todo lo demás: portal del propietario
    location / { proxy_pass http://127.0.0.1:3000; }
  }
}